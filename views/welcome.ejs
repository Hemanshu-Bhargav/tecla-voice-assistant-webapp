  <!-- Python Command-line arugments -->
  <form action="/submitform" method="POST">
    <div class="figmabluebox">
      <!--
      <label for="endcall">End Call</label><br>
      <input type="text"</input>
      <label for="hangup">Hang Up</label><br>
      <input type="radio" id="gain" name="gain" value="2">
      <label for="disconnectcall">Disconnect Call</label><br>
      -->
      <p>Alternatively, choose your own name.</p>
      <label for="hotword">Please type in the phrase you would like Tecla to respond to:</label><br>
      <input
        type="text"
        id="hotword"
        name="hotword"
        class="form-control"
        placeholder="Custom Phrase"
      </input>
    </div>
    <!-- "Voice Type" (stand-in for gender) Should be a radio button -->
    <div class="figmabluebox">
      <p>Voice Type</p>
      <input type="radio" id="voicetype" name="voicetype" value="F">
      <label for="voicetype">I speak softly</label><br>
      <input type="radio" id="voicetype" name="voicetype" value="F">
      <label for="voicetype">I'm somewhere in between</label><br>
      <input type="radio" id="voicetype" name="voicetype" value="M">
      <label for="voicetype">I speak loudly</label><br>
    </div>
    <!-- Gain should be a radio button -->
    <div class="figmabluebox">
      <p>Microphone Volume</p>
      <input type="radio" id="gain" name="gain" value="0">
      <label for="gain">I speak softly</label><br>
      <input type="radio" id="gain" name="gain" value="1">
      <label for="gain">I'm somewhere in between</label><br>
      <input type="radio" id="gain" name="gain" value="2">
      <label for="gain">I speak loudly</label><br>
    </div>
    <button onclick="func()" type="submit" class="btn btn-primary btn-block">Create My Custom Phrase</button>
  </form>
  <!-- new button test -->
  <script>
    const func = () => fetch('http://localhost:3000'); //connect to this page
  </script>

